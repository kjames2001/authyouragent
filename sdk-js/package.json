{
  "name": "authyouragent",
  "version": "0.2.0",
  "description": "Auth Your Agent SDK: let AI agents act for a person on websites, with the person's approval on their phone.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./takeover": {
      "types": "./src/takeover.d.ts",
      "default": "./src/takeover.js"
    }
  },
  "peerDependencies": { "ws": ">=8" },
  "peerDependenciesMeta": { "ws": { "optional": true } },
  "files": ["src", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": ["ai-agents", "authorization", "dpop", "webauthn", "identity"],
  "homepage": "https://authyouragent.com/docs/developers/quickstart",
  "license": "MIT"
}
